# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/roomludo"

# JWT_SECRET: Secret for signing authentication tokens
JWT_SECRET="roomludo_super_secure_jwt_secret_key_2026"

# REDIS_URL: Redis connection for matchmaking and room caching
REDIS_URL="redis://localhost:6379"

# PAYMENT_PROVIDER_KEYS: Payment gateway keys (e.g. Razorpay, Cashfree)
PAYMENT_PROVIDER_KEY="rzp_live_sample_key"
PAYMENT_PROVIDER_SECRET="rzp_secret_sample_key"

# STORAGE_KEYS: S3 / Cloud Storage keys for KYC document retention
STORAGE_BUCKET_NAME="roomludo-kyc-vault"

